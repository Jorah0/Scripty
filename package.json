{
  "name": "scripty",
  "productName": "Scripty",
  "version": "1.1.0",
  "description": "Scripty — AI Script Studio. Write, revise and perform scripts with Claude, ChatGPT, Gemini, Ollama and more.",
  "main": "main.js",
  "author": "Scripty",
  "license": "MIT",
  "scripts": {
    "start": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "test": "node --test test/*.test.js",
    "smoke": "set ELECTRON_RUN_AS_NODE=&& electron . --smoke",
    "verify": "node --test test/*.test.js && set ELECTRON_RUN_AS_NODE=&& electron . --smoke",
    "icon": "python build/make_icon.py",
    "android": "powershell -ExecutionPolicy Bypass -File android/build-apk.ps1",
    "emulator": "powershell -ExecutionPolicy Bypass -File android/emulator.ps1",
    "test:android": "node test/android.e2e.js",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.scripty.studio",
    "productName": "Scripty",
    "copyright": "Scripty",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "android/dist",
        "to": "android",
        "filter": [
          "Scripty-Remote.apk",
          "version.json"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Scripty",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Scripty-Portable-${version}.exe"
    }
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
